# Copy to .env for local development. .env is never committed.
REORDER_HOST=127.0.0.1
PORT=8000

# Password for the database in compose.yaml. Use letters, digits, - and _ only.
POSTGRES_PASSWORD=change-me
REORDER_DATABASE_URL=postgresql+psycopg://reorder:${POSTGRES_PASSWORD}@127.0.0.1:5432/reorder

# Print every SQL statement the app runs. For debugging only.
REORDER_DATABASE_ECHO=false
